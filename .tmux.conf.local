# ~/.tmux.conf.local
# gpakosz/.tmux (oh-my-tmux) 的本地覆盖文件。
# 主 .tmux.conf 末尾(第140行)会 `source ~/.tmux.conf.local`,
# 因此这里的设置在主文件之后加载,可以覆盖主文件。
# 原则:只在本文件里做覆盖,不直接改主 .tmux.conf,方便将来升级 oh-my-tmux。

# --- 默认 shell 改回 bash ----------------------------------------------------
# 主文件第17-18行把 default-shell/command 设成了 /bin/zsh,
# 但本机 dotfiles 全配在 bash(~/.bashrc 软链生效, ~/.zshrc 不存在),
# tmux 里起裸 zsh 会导致所有 alias/函数(gs/gc/cxd/cxx/cxt 等)都不加载。
# 改回 bash 后,tmux 内的每个 pane 都会正常加载 my_dot_files 配置。
set -g default-shell   /bin/bash
set -g default-command /bin/bash

# --- 加大滚动历史 ------------------------------------------------------------
# 主文件第25行设的是 history-limit 5000,Claude 等工具长输出容易把回滚缓冲冲掉。
# 调大到 50000,长输出不丢。
# (注:base-index / pane-base-index 已是主文件默认的 1,无需在此重复设置。)
set -g history-limit 50000

# --- 鼠标滚轮 & 终端类型:修复"往上滑内容被遮挡" -----------------------------
# 现象:mouse off 时滚轮不归 tmux 管,事件穿到外层终端去翻它自己的 scrollback,
#      而 tmux 状态栏 + Claude 的输入框/spinner 一直重绘,一重绘就把滑上去看的
#      内容盖掉。开 mouse 后滚轮直接进 copy-mode 滚 tmux 自己的 50000 行历史,
#      不再走外层终端那条错路,遮挡消失。(前缀 + m 也能临时开关鼠标)
set -g mouse on

# 主文件第12行把 default-terminal 设成老旧的 screen-256color,清行/重绘能力弱,
# 容易留残影、叠字。换成更新的 tmux-256color,重绘更干净。
# 注:default-terminal 只对"新开的 pane / 重启 tmux 服务"生效。
set -g default-terminal "tmux-256color"
# 保留真彩色(本机 COLORTERM=truecolor,外层是 xterm-256color)。
set -ga terminal-overrides ",xterm-256color:Tc"

# --- tmux-resurrect + tmux-continuum(方案 B:手动 clone 直接 source)----------
# 插件由 common_init_funcs.sh 的 installTmuxPlugins() clone 到 ~/.tmux/plugins/。
# 选项必须在 source 插件脚本之前设置;且 resurrect 要在 continuum 之前 source。
# 存档键: prefix + Ctrl-s   恢复键: prefix + Ctrl-r
# 存档目录: ~/.local/share/tmux/resurrect/
set -g @resurrect-capture-pane-contents 'on'  # 连同 pane 屏幕内容一起存
set -g @resurrect-strategy-vim 'session'      # 恢复 vim 会话(需 pane 工作目录里有 Session.vim)
set -g @continuum-restore 'on'                # tmux 服务启动时自动恢复上次环境
set -g @continuum-save-interval '5'           # 每 5 分钟自动存一次

run-shell ~/.tmux/plugins/tmux-resurrect/resurrect.tmux
run-shell ~/.tmux/plugins/tmux-continuum/continuum.tmux
