# Brewfile for my_dot_files

tap "homebrew/core"
tap "homebrew/cask"

# Basic Tools
brew "git"
brew "wget"
brew "curl"
brew "zsh"
brew "tmux"

# Development Tools
brew "go"
brew "rustup" # Managing Rust via Homebrew is one option, or use rustup-init
brew "jq"
brew "nmap"

# Productivity
brew "eza"       # Modern ls
brew "autojump"  # Directory navigation
brew "the_silver_searcher" # ag
brew "ripgrep"   # rg (faster than ag)
brew "fd"        # Modern find
brew "bat"       # Modern cat
brew "glow"      # Terminal Markdown renderer
brew "git-delta" # Better git diff

# System Tools
brew "coreutils" # GNU utils
brew "gnu-sed"
brew "pipx"      # For installing Python applications

# Diagram Tools
brew "plantuml"
brew "graphviz"  # PlantUML dependency

# GUI Apps (Optional - commented out by default)
cask "google-chrome"
cask "visual-studio-code"
cask "sublime-text"
cask "typora"

# Currently Installed Apps
cask "docker-desktop"     # Docker Desktop
cask "mactex"             # MacTeX distribution
cask "alfred"             # Application launcher and productivity software
cask "vlc"                # Multimedia player
cask "iterm2"             # Terminal emulator
cask "goland"             # Go IDE by JetBrains
cask "postman"            # API development environment
cask "transmission"       # BitTorrent client
cask "cursor"             # AI-powered code editor
cask "lark"               # Collaboration platform
cask "wechat"             # Messaging app